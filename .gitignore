# Response cache and budget state: machine-local, regenerable, and large.
.cache/
.budget/

# Traces are the evidence for every number in the paper, but they are big.
# Keep them locally; commit only the derived tables in analysis/out/.
traces/
!traces/.gitkeep

# Secrets
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/

# Vendored upstream benchmark: pinned by SHA in README, not committed wholesale.
vendor/agentdojo/

# OS
Thumbs.db
desktop.ini

# Colab round-trips: the archive and any local extraction of it (the contents are
# merged into .cache/, traces/ and analysis/out/, which have their own rules above).
*.tgz
cache/

# Offline wiring checks (--fake) and the notebook's old auto-printed entry: not results.
analysis/out/*_fake.json
analysis/out/phase1_results_entry.md
