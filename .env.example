# Copy to .env and fill in. .env is gitignored.

# Credentials. If you have run `ant auth login`, the SDK picks up the profile
# and you do not need to set this at all.
ANTHROPIC_API_KEY=

# Models (implementation-plan.md Phase 5).
# Primary carries the full grid; spotcheck runs a 20% stratified slice so the
# finding is not single-model. Measured estimate at 150 cases x 5 languages x
# 9 defense configs: ~$39 primary + ~$39 spotcheck slice.
AGENTFW_PRIMARY_MODEL=claude-haiku-4-5
AGENTFW_SPOTCHECK_MODEL=claude-opus-5

# Per-phase hard spend cap in USD. harness/budget.py refuses calls past it and
# the state persists across restarts.
AGENTFW_BUDGET_USD=25

# Determinism. Fixed so cells are comparable and the cache actually hits.
AGENTFW_TEMPERATURE=0.0
AGENTFW_SEED=20260916
